; Fog sprites and the screen fog layer (fog.c): position, texcoord and a 0..255 colour, no lighting.
; The PC draws them with D3D fog off and the texture stage set to MODULATE2X (0x487470).

.fvec projection[4], modelView[4]

.constf consts(0.0, 1.0, 0.00392156862745, 0.0)
.alias  ones   consts.yyyy
.alias  inv255 consts.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex
	mul outclr, inv255, inclr
	end
.end
