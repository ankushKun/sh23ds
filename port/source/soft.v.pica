; The Picture's soft pass (picture.c): a quad in the target's own pixels, and the texture coordinate
; of one bilinear tap of the scene's copy: the position moved by the tap's offset (in the target's
; pixels) and mapped onto the texture.

.fvec projection[4]
.fvec taps        ; x, y: the tap's offset
.fvec uvscale     ; texture units per target pixel along x and y
.fvec uvbase      ; the texture coordinate at the target's origin

.constf consts(0.5, 1.0, 0.0, 0.0)

.out outpos position
.out outtc0 texcoord0

.alias inpos v0

.proc main
	mov r0.xy, inpos
	mov r0.z,  consts.x
	mov r0.w,  consts.y

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	add r1.xy, taps.xy, inpos.xy
	mul r1.xy, uvscale.xy, r1.xy
	add outtc0.xy, uvbase.xy, r1.xy
	end
.end
