; Movie quad (movie.c): screen position in the 400x240 ortho space plus a texcoord, no lighting.

.fvec projection[4]

.constf consts(0.5, 1.0, 0.0, 0.0)

.out outpos position
.out outtc0 texcoord0

.alias inpos v0
.alias intex v1

.proc main
	mov r0.xy, inpos
	mov r0.z,  consts.x
	mov r0.w,  consts.y

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intex
	end
.end
