; Skinned character geometry: four bone influences from a palette of up to 28 bones.
; inidx holds palette slot * 3 (one 3x4 matrix = three rows), inwgt the weights as 0..255.
; Normals are skinned with the same blend and output as view vector + normal quaternion for
; fragment lighting (same as world.v.pica).

.fvec projection[4], modelView[4]
.fvec bones[84]

.constf consts(0.0, 1.0, 0.00392156862745, 0.5)
.alias  zeros  consts.xxxx
.alias  ones   consts.yyyy
.alias  inv255 consts.zzzz
.alias  half   consts.wwww

.out outpos position
.out outtc0 texcoord0
.out outclr color
.out outview view
.out outnq normalquat

.alias inpos v0
.alias intex v1
.alias inidx v2
.alias inwgt v3
.alias innrm v4

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones
	mul r4, inv255, inwgt

	; influences 0 and 1
	mova a0.xy, inidx.xy
	dp4 r1.x, bones[a0.x],   r0
	dp4 r1.y, bones[a0.x+1], r0
	dp4 r1.z, bones[a0.x+2], r0
	mul r3.xyz, r4.xxxx, r1
	dp3 r1.x, bones[a0.x],   innrm
	dp3 r1.y, bones[a0.x+1], innrm
	dp3 r1.z, bones[a0.x+2], innrm
	mul r7.xyz, r4.xxxx, r1
	dp4 r1.x, bones[a0.y],   r0
	dp4 r1.y, bones[a0.y+1], r0
	dp4 r1.z, bones[a0.y+2], r0
	mad r3.xyz, r4.yyyy, r1, r3
	dp3 r1.x, bones[a0.y],   innrm
	dp3 r1.y, bones[a0.y+1], innrm
	dp3 r1.z, bones[a0.y+2], innrm
	mad r7.xyz, r4.yyyy, r1, r7

	; influences 2 and 3
	mova a0.xy, inidx.zw
	dp4 r1.x, bones[a0.x],   r0
	dp4 r1.y, bones[a0.x+1], r0
	dp4 r1.z, bones[a0.x+2], r0
	mad r3.xyz, r4.zzzz, r1, r3
	dp3 r1.x, bones[a0.x],   innrm
	dp3 r1.y, bones[a0.x+1], innrm
	dp3 r1.z, bones[a0.x+2], innrm
	mad r7.xyz, r4.zzzz, r1, r7
	dp4 r1.x, bones[a0.y],   r0
	dp4 r1.y, bones[a0.y+1], r0
	dp4 r1.z, bones[a0.y+2], r0
	mad r3.xyz, r4.wwww, r1, r3
	dp3 r1.x, bones[a0.y],   innrm
	dp3 r1.y, bones[a0.y+1], innrm
	dp3 r1.z, bones[a0.y+2], innrm
	mad r7.xyz, r4.wwww, r1, r7
	mov r3.w, ones

	dp4 r1.x, modelView[0], r3
	dp4 r1.y, modelView[1], r3
	dp4 r1.z, modelView[2], r3
	dp4 r1.w, modelView[3], r3
	mov outview, -r1

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov r2, intex
	add r2.y, ones, -r2
	mov outtc0, r2
	mov outclr, ones

	; skinned normal to view space, normalised
	dp3 r14.x, modelView[0], r7
	dp3 r14.y, modelView[1], r7
	dp3 r14.z, modelView[2], r7
	dp3 r6.x, r14, r14
	rsq r6.x, r6.x
	mul r14.xyz, r14.xyz, r6.x

	; quaternion rotating +Z onto the normal
	mov r0, consts.yxxx
	add r4, ones, r14.z
	mul r4, half, r4
	cmp zeros, ge, ge, r4.x
	rsq r4, r4.x
	mul r5, half, r14
	jmpc cmp.x, degenerate
	rcp r0.z, r4.x
	mul r0.xy, r5, r4
degenerate:
	mov outnq, r0
	end
.end
